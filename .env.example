# Copy to .env.local. Never commit real credentials.
DATABASE_URL=postgresql://tidehouse:local-development-only@localhost:5432/tidehouse
APP_URL=http://localhost:3000
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=
# Generate: npm run admin:password -- 'your-long-unique-password'
ADMIN_PASSWORD_HASH=
# simulator is explicitly a local, non-provider test harness. Never silently falls back.
PAYMENT_PROVIDER=simulator
ALLOW_PAYMENT_SIMULATOR=true
# For Stripe sandbox use PAYMENT_PROVIDER=stripe and set sk_test_ / whsec_ values.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional actual confirmation email delivery through Resend.
RESEND_API_KEY=
EMAIL_FROM=
# Protected maintenance endpoint: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
# Only set behind a trusted reverse proxy which overwrites X-Forwarded-For.
TRUST_PROXY=false
