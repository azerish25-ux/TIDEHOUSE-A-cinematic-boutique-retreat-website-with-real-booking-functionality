# Copy to .env. Never commit credentials.
DATABASE_URL=postgresql://tidehouse:tidehouse-local-only@localhost:5432/tidehouse
APP_ORIGIN=http://localhost:3000
PORT=3000
APP_ENV=development
# Explicit local/test mode. Production requires stripe (test keys only).
PAYMENT_PROVIDER=simulated
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Generate with npm run admin:password -- 'a-long-unique-passphrase'
ADMIN_PASSWORD_HASH=
# Mailpit inbox: http://localhost:8025
SMTP_URL=smtp://localhost:1025
MAIL_FROM=TIDEHOUSE <stays@tidehouse.example>
# Enable only behind a trusted single-hop reverse proxy.
TRUST_PROXY=false
NEXT_PUBLIC_PREVIEW=0
NEXT_PUBLIC_BASE_PATH=
