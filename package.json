{
  "name": "tidehouse",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/domain.test.ts tests/release.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 tests/booking.test.ts",
    "test:e2e": "playwright test",
    "db:setup": "tsx scripts/setup.ts",
    "admin:password": "tsx scripts/password.ts",
    "format": "prettier --write app components lib scripts tests *.ts *.json README.md"
  },
  "dependencies": {
    "next": "^16.2.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "pg": "^8.16.3",
    "stripe": "^18.5.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "tsx": "^4.20.5",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/pg": "^8.15.5",
    "@playwright/test": "^1.58.2",
    "@axe-core/playwright": "^4.11.0",
    "prettier": "3.6.2"
  }
}
