{
  "name": "tidehouse",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.16" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "tsx server/index.ts",
    "db:migrate": "tsx server/migrate.ts",
    "admin:password": "tsx scripts/password.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/unit.test.ts",
    "test:integration": "node scripts/guard-tests.mjs && tsx --test --test-concurrency=1 tests/integration.test.ts",
    "test:e2e": "playwright test",
    "worker": "tsx server/worker.ts"
  },
  "dependencies": {
    "next": "16.3.6", "react": "19.3.0", "react-dom": "19.3.0",
    "express": "^5.1.0", "pg": "^8.16.3", "stripe": "22.6.2",
    "zod": "^4.1.12", "nodemailer": "^7.0.6", "tsx": "^4.20.5",
    "@fontsource/cormorant-garamond": "^5.2.6", "@fontsource/manrope": "^5.2.6"
  },
  "devDependencies": {
    "typescript": "^5.9.2", "@types/node": "^22.18.6", "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9", "@types/express": "^5.0.3", "@types/pg": "^8.15.5",
    "@types/nodemailer": "^7.0.1", "@playwright/test": "^1.55.1", "@axe-core/playwright": "^4.10.2"
  }
}
